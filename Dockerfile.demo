# Imagen de la demo pública en Render (plan gratuito). Modo local: sin Azure y sin costo.
# La usa render.yaml. La imagen de producción en Azure es el Dockerfile principal.
FROM python:3.12-slim

ENV PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

RUN useradd --create-home --uid 10001 app
WORKDIR /app

COPY pyproject.toml README.md ./
COPY src ./src
RUN pip install ".[demo]"

COPY configs ./configs
COPY data/sample ./data/sample
COPY data/processed ./data/processed

# Asegurar que el índice esté construido y listo en el build
RUN python -m riskrag.cli ingest data/sample && \
    mkdir -p /tmp/audit && chown -R app:app /tmp/audit

ENV RISKRAG_PROJECT_ROOT=/app \
    RISKRAG_ENV=local \
    RISKRAG_HOME_PATH=/demo \
    RISKRAG_INDEX_PATH=/app/data/processed/index.json \
    RISKRAG_AUDIT_LOG_PATH=/tmp/audit/audit.jsonl \
    RISKRAG_AUDIT_STDOUT=true \
    RISKRAG_RATE_LIMIT_PER_MINUTE=20 \
    FORWARDED_ALLOW_IPS="*" \
    GRADIO_ANALYTICS_ENABLED=False

USER 10001
EXPOSE 10000

# El índice ya viene pre-cargado: Uvicorn arranca de inmediato sin demoras
CMD ["sh", "-c", "exec uvicorn riskrag.demo.app:app --host 0.0.0.0 --port ${PORT:-10000} --proxy-headers --no-server-header"]
