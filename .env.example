# Copiar a .env (ignorado por git). Valores por defecto = modo local sin Azure.
RISKRAG_ENV=local
RISKRAG_EMBEDDER_BACKEND=hashing      # hashing | azure_openai
RISKRAG_VECTOR_BACKEND=memory         # memory | pgvector
RISKRAG_LLM_BACKEND=extractive        # extractive | azure_openai
RISKRAG_RERANKER_BACKEND=lexical      # lexical | azure_cohere | none
RISKRAG_GUARDRAIL_BACKEND=local       # local | azure_content_safety

# Azure OpenAI. Sin API key se usa Microsoft Entra ID (az login en local,
# identidad administrada en Container Apps). Confirmar modelos disponibles en la región.
# RISKRAG_AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com/
# RISKRAG_AZURE_OPENAI_API_KEY=
RISKRAG_AZURE_OPENAI_API_VERSION=2024-10-21
RISKRAG_AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4.1-mini
RISKRAG_AZURE_OPENAI_EMBED_DEPLOYMENT=text-embedding-3-large
# Modelos de razonamiento (familia o-series o gpt-5) no aceptan temperature:
# RISKRAG_AZURE_OPENAI_SEND_TEMPERATURE=false

# Azure AI Content Safety (Prompt Shields + moderación)
# RISKRAG_AZURE_CONTENT_SAFETY_ENDPOINT=https://<recurso>.cognitiveservices.azure.com/
# RISKRAG_AZURE_CONTENT_SAFETY_API_KEY=

# Rerank opcional: Cohere Rerank desplegado como modelo serverless en Azure AI Foundry
# RISKRAG_AZURE_RERANK_ENDPOINT=https://<despliegue>.<region>.models.ai.azure.com
# RISKRAG_AZURE_RERANK_API_KEY=

# pgvector local (docker compose) o Azure Database for PostgreSQL
# RISKRAG_PG_DSN=host=127.0.0.1 port=5432 user=riskrag password=... dbname=riskrag

# API keys: lista JSON de hashes SHA-256. Generar con: make api-key
# RISKRAG_API_KEYS_SHA256=["<hash>"]

# Microsoft Entra ID (tokens Bearer) y Front Door: los define Terraform en Azure
# RISKRAG_TRUST_ENTRA_JWT=true
# RISKRAG_ENTRA_TENANT_ID=
# RISKRAG_ENTRA_AUDIENCE=
# RISKRAG_FRONT_DOOR_ID=

# Plataforma de riesgo crediticio (credit-risk-ml-platform)
# RISKRAG_CREDIT_MODEL_URL=https://credit-risk-api-mdix.onrender.com
