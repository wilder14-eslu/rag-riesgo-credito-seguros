# Copiar a .env (ignorado por git). Valores por defecto = modo local sin AWS.
RISKRAG_ENV=local
RISKRAG_EMBEDDER_BACKEND=hashing      # hashing | bedrock
RISKRAG_VECTOR_BACKEND=memory         # memory | pgvector
RISKRAG_LLM_BACKEND=extractive        # extractive | bedrock
RISKRAG_RERANKER_BACKEND=lexical      # lexical | bedrock | none
RISKRAG_GUARDRAIL_BACKEND=local       # local | bedrock
RISKRAG_AWS_REGION=us-east-1

# Bedrock (confirmar modelos habilitados en la región)
RISKRAG_BEDROCK_LLM_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
RISKRAG_BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
RISKRAG_BEDROCK_RERANK_MODEL_ID=cohere.rerank-v3-5:0
# RISKRAG_BEDROCK_GUARDRAIL_ID=

# pgvector local (docker compose)
# RISKRAG_PG_DSN=host=127.0.0.1 port=5432 user=riskrag password=... dbname=riskrag

# API keys: lista JSON de hashes SHA-256. Generar con: make api-key
# RISKRAG_API_KEYS_SHA256=["<hash>"]

# Plataforma de riesgo crediticio (credit-risk-ml-platform)
# RISKRAG_CREDIT_MODEL_URL=https://credit-risk-api-mdix.onrender.com
